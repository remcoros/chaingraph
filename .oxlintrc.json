                "message": "Persistence consumes Core document contracts and its persistence port, never App or the concrete session runtime."
              },
              {
                "group": ["**/Persistence/**", "!**/Persistence/index", "!**/Persistence/index.ts"],
                "message": "Import the Persistence public index, never its private implementation files."
              },
              {
                "group": ["**/Formatting/**", "!**/Formatting/index", "!**/Formatting/index.ts"],
                "message": "Import Formatting through its public index, not its implementation files."
              },
              {
                "group": ["**/Domain/**"],
                "message": "Domain has been removed. Import the actual Core or App owner."

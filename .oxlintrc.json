{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {},
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/set-state-in-render": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/preserve-manual-memoization": "error",
    "react/immutability": "error",
    "react/purity": "error",
    "eslint/no-control-regex": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-useless-escape": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react/no-danger": "error",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "oxc/no-async-await": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "artifacts/**", "test-results/**", "public/**"],
  "overrides": [
    {
      "files": ["src/Domain/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/App/**", "**/Infra/**"],
                "message": "Domain holds contracts and pure logic. It must not depend on the app, transport, storage or UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/Infra/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/App/**"],
                "message": "Infra carries transport and storage. Depend on Domain only, never on the app or UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/App/Workspace/Workbenches/Wallet/**",
        "src/App/Workspace/Workbenches/Analysis/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/Workbenches/Graph/**", "../Graph/**", "../../Graph/**"],
                "message": "Reach Graph through the GraphHandoff contract in Workbenches/workbenchHandoff.ts, not through its own modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/App/Workspace/ChainData/**", "src/App/Workspace/Selection/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/Workbenches/**", "../Workbenches/**"],
                "message": "Workspace-scope code is shared by every workbench and must not depend on one of them."
              }
            ]
          }
        ]
      }
    }
  ]
}

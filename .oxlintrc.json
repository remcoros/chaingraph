{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {},
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/set-state-in-render": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/preserve-manual-memoization": "error",
    "react/immutability": "error",
    "react/purity": "error",
    "eslint/no-control-regex": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-useless-escape": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react/no-danger": "error",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "oxc/no-async-await": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "import/no-cycle": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/Persistence/**", "!**/Persistence/index", "!**/Persistence/index.ts"],
            "message": "Import the Persistence public index, never its private implementation files."
          },
          {
            "group": ["**/Formatting/**", "!**/Formatting/index", "!**/Formatting/index.ts"],
            "message": "Import Formatting through its public index, not its implementation files."
          },
          {
            "group": ["**/Domain/**"],
            "message": "Domain has been removed. Import the actual Core or App owner."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "artifacts/**", "test-results/**", "public/**"],
  "overrides": [
    {
      "files": ["src/Core/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*", "**/App/**"],
                "message": "Core production code is independent of React and App. App supplies UI and composition."
              },
              {
                "group": ["**/Persistence/**", "!**/Persistence/index", "!**/Persistence/index.ts"],
                "message": "Import the Persistence public index, never its private implementation files."
              },
              {
                "group": ["**/Formatting/**", "!**/Formatting/index", "!**/Formatting/index.ts"],
                "message": "Import Formatting through its public index, not its implementation files."
              },
              {
                "group": ["**/Domain/**"],
                "message": "Domain has been removed. Import the actual Core or App owner."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["src/Core/Workspace/Persistence/Integration/**"]
    },
    {
      "files": ["src/Core/Workspace/Persistence/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",

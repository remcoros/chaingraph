{
  "name": "chaingraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --use-system-ca --import tsx scripts/dev.ts",
    "dev:live": "node --use-system-ca --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs",
    "start": "node --use-system-ca --import tsx server/index.ts",
    "start:live": "node --use-system-ca --import tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "CHAINGRAPH_E2E_PREVIEW=1 playwright test",
    "lint": "oxlint --config .oxlintrc.json src server scripts tests",
    "lint:fix": "oxlint --config .oxlintrc.json --fix src server scripts tests",
    "check:compiler": "node scripts/check-react-compiler.mjs",
    "check": "npm run check:portability && npm run lint && npm run build && npm test",
    "check:portability": "node scripts/check-portability.mjs",
    "test:live": "node --use-system-ca --import tsx scripts/smoke-live.ts",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write src server scripts tests *.ts *.css *.json",
    "format:check": "prettier --check src server scripts tests *.ts *.css *.json",
    "test:production:http": "node --use-system-ca --import tsx scripts/smoke-production-http.ts",
    "test:production": "npm run test:production:http && node --use-system-ca --import tsx scripts/smoke-production.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "3d-force-graph": "^1.80.0",
    "bitcoinjs-lib": "^7.0.2",
    "d3-force-3d": "3.0.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxc-transform-react": "^0.145.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

# Public template for ONE isolated Core/Fulcrum pair.
# Copy to .env.testnet4 or .env.mainnet and configure that network's upstreams.
# Both files may coexist. Never load either file into process.env or Compose env_file.
# The filename determines the network; an optional declaration must match it:
# BITCOIN_NETWORK=testnet4
# These example ports are placeholders for a local testnet4 setup. Change them
# and the hosts to match your own services, especially when using a container.
# This file uses dotenv syntax. Quote values containing #; dollar signs are not expanded.

BITCOIN_RPC_URL=http://127.0.0.1:48332
# Choose exactly one authentication mode. For cookie authentication, comment
# out both user/password lines and mount the cookie read-only at the given path.
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
# BITCOIN_RPC_COOKIE_FILE=/run/bitcoin-core/.cookie

# Optional application use of an already configured Core 31+ txospenderindex.
# DEFAULT OFF. This does not enable or change the index on Bitcoin Core.
# Missing, syncing or unsupported indexes use bounded Electrum history fallback.
CHAINGRAPH_USE_TXOSPENDERINDEX=false

FULCRUM_HOST=127.0.0.1
FULCRUM_PORT=51001
FULCRUM_TLS=false

UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_REQUEST_TIMEOUT_MS=30000
UPSTREAM_QUEUE_TIMEOUT_MS=30000
CORE_RPC_MAX_CONCURRENCY=16
CORE_RPC_MAX_PENDING=256
FULCRUM_MAX_CONCURRENCY=16
FULCRUM_MAX_PENDING=256
MAX_ADDRESS_HISTORY_TXS=1000
MAX_RESPONSE_BYTES=5242880
# Shared HTTP host/port/origins/rate limits belong to the process environment,
# not these per-network files. See docs/deployment.md.

# One process serves one network and one matching upstream pair.
BITCOIN_NETWORK=testnet4

BITCOIN_RPC_URL=http://127.0.0.1:48332
# Choose exactly one authentication mode. For cookie authentication, comment
# out both user/password lines and mount the cookie read-only at the given path.
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
# BITCOIN_RPC_COOKIE_FILE=/run/bitcoin-core/.cookie

FULCRUM_HOST=127.0.0.1
FULCRUM_PORT=51001
FULCRUM_TLS=false

SERVER_HOST=127.0.0.1
SERVER_PORT=3000
# Comma-separated frontend origins; dev startup adds its loopback origin.
CORS_ALLOW_ORIGINS=http://127.0.0.1:3001
SERVER_HANDLER_TIMEOUT_MS=120000

UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_REQUEST_TIMEOUT_MS=30000
UPSTREAM_QUEUE_TIMEOUT_MS=30000
CORE_RPC_MAX_CONCURRENCY=16
CORE_RPC_MAX_PENDING=256
FULCRUM_MAX_CONCURRENCY=8
FULCRUM_MAX_PENDING=256
MAX_ADDRESS_HISTORY_TXS=1000
MAX_RESPONSE_BYTES=5242880
# 0 disables inbound HTTP rate limiting; set a positive maximum to opt in.
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=60000
